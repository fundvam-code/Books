{
    default_sni {$PUBLIC_DOMAIN}
    auto_https disable_redirects
    servers {
        protocols h1 h2
    }
}

(dashboard_tls_default) {
}

(dashboard_tls_internal) {
    tls internal
}

(dashboard_tls_ip) {
    tls {
        issuer acme {
            profile shortlived
        }
    }
}

:80 {
    redir https://{$PUBLIC_DOMAIN}:{$DASHBOARD_HTTPS_PORT:8443}{uri} permanent
}

https://{$PUBLIC_DOMAIN} {
    import dashboard_tls_{$DASHBOARD_TLS_MODE:default}
    header {
        Cache-Control "no-store"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        -Alt-Svc
    }
    handle /api/agent/* {
        reverse_proxy dashboard:8000
    }
    handle {
        basic_auth {
            {$DASHBOARD_USERNAME} {$DASHBOARD_PASSWORD_HASH}
        }
        reverse_proxy dashboard:8000 {
            header_up -Authorization
        }
    }
}
