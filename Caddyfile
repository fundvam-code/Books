{$PUBLIC_DOMAIN} {
    header {
        Cache-Control "no-store"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    handle /api/agent/* {
        reverse_proxy dashboard:8000
    }
    handle {
        basic_auth {
            {$DASHBOARD_USERNAME} {$DASHBOARD_PASSWORD_HASH}
        }
        reverse_proxy dashboard:8000 {
            header_up -Authorization
        }
    }
}
