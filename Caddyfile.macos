{
    default_sni 127.0.0.1
    auto_https disable_redirects
    servers {
        protocols h1 h2
    }
}

https://127.0.0.1 {
    tls internal
    header {
        Cache-Control "no-store"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        -Alt-Svc
    }
    handle /api/agent/* {
        reverse_proxy dashboard:8000
    }
    handle {
        reverse_proxy dashboard:8000 {
            header_up -Authorization
        }
    }
}
